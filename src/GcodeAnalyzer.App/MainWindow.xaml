<Window x:Class="GcodeAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="G-Code-Analyzer" Height="800" Width="1200" MinWidth="700" MinHeight="450"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="2" Margin="8" LastChildFill="True">
            <Button DockPanel.Dock="Left" Padding="12,4" Click="OnOpen">Datei öffnen …</Button>
            <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="200" Height="14" Maximum="1" Visibility="Collapsed"/>
            <TextBlock x:Name="Status" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Border Grid.Row="1" Margin="8,0,4,8" BorderBrush="#DDD" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="16" Foreground="Gray">G-Code-Datei hierher ziehen oder „Datei öffnen“ wählen</TextBlock>
                <Image x:Name="Preview" Stretch="Uniform" Margin="24" MaxWidth="400" MaxHeight="400"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="4,0,8,8" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Sections">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Header="{Binding Title}" IsExpanded="True" Margin="0,0,0,8" FontWeight="SemiBold">
                            <ItemsControl ItemsSource="{Binding Rows}" Margin="8,4,0,0" FontWeight="Normal">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" MaxWidth="190"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding Label}" Foreground="#555"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
