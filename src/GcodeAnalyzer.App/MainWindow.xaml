<Window x:Class="GcodeAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        xmlns:local="clr-namespace:GcodeAnalyzer.App"
        Title="G-Code-Analyzer" Height="800" Width="1200" MinWidth="700" MinHeight="450"
        Icon="app.ico" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="2" Margin="8" LastChildFill="True">
            <Button DockPanel.Dock="Left" Padding="12,4" Click="OnOpen" Style="{StaticResource IconButton}"
                    Tag="{StaticResource Icon.folder-open}" Content="Datei öffnen …"/>
            <Button DockPanel.Dock="Right" Padding="10,4" Margin="8,0,0,0" Click="OnAbout" Style="{StaticResource IconButton}"
                    Tag="{StaticResource Icon.circle-info}" Content="Über" AutomationProperties.Name="Über"/>
            <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="200" Height="14" Maximum="1" Visibility="Collapsed"/>
            <TextBlock x:Name="Status" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="8,0,4,8" Background="#303030">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <hx:Viewport3DX x:Name="Viewport" BackgroundColor="#303030" ShowViewCube="True" ShowCoordinateSystem="False"
                            ModelUpDirection="0,0,1" EnableSwapChainRendering="False" FXAALevel="Low"
                            ShowFrameRate="False" TextBrush="White">
                <hx:Viewport3DX.Camera>
                    <hx:PerspectiveCamera Position="110,-150,180" LookDirection="0,260,-180" UpDirection="0,0,1"
                                          NearPlaneDistance="1" FarPlaneDistance="5000"/>
                </hx:Viewport3DX.Camera>
                <hx:Viewport3DX.InputBindings>
                    <MouseBinding Command="hx:ViewportCommands.Rotate" Gesture="LeftClick"/>
                    <MouseBinding Command="hx:ViewportCommands.Pan" Gesture="RightClick"/>
                    <MouseBinding Command="hx:ViewportCommands.Pan" Gesture="MiddleClick"/>
                    <MouseBinding Command="hx:ViewportCommands.ZoomExtents" Gesture="LeftDoubleClick"/>
                </hx:Viewport3DX.InputBindings>
                <hx:AmbientLight3D Color="White"/>
                <hx:GroupModel3D x:Name="SceneRoot"/>
            </hx:Viewport3DX>

            <TextBlock x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="16" Foreground="#AAA">G-Code-Datei hierher ziehen oder „Datei öffnen“ wählen</TextBlock>

            <Border x:Name="LegendPanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                    Background="#C0202020" CornerRadius="4" Padding="8,6">
                <StackPanel>
                    <StackPanel.Resources>
                        <!-- Fluent-Checkboxen sind 32 px hoch; in der Legende kompakt -->
                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                            <Setter Property="MinHeight" Value="22"/>
                            <Setter Property="Padding" Value="6,0,0,0"/>
                        </Style>
                    </StackPanel.Resources>
                    <ComboBox x:Name="ColorModeBox" SelectedIndex="0" Margin="0,0,0,6" SelectionChanged="OnColorModeChanged"
                              AutomationProperties.Name="Einfärbung">
                        <ComboBoxItem>Pfad-Kategorie</ComboBoxItem>
                        <ComboBoxItem>Geschwindigkeit</ComboBoxItem>
                        <ComboBoxItem>Volumenstrom</ComboBoxItem>
                        <ComboBoxItem>Layerzeit</ComboBoxItem>
                    </ComboBox>
                    <StackPanel x:Name="HeatLegend" Visibility="Collapsed" Margin="0,0,0,6">
                        <Rectangle x:Name="HeatBar" Height="10"/>
                        <DockPanel>
                            <TextBlock x:Name="HeatMax" DockPanel.Dock="Right" Foreground="White" FontSize="11"/>
                            <TextBlock x:Name="HeatMin" Foreground="White" FontSize="11"/>
                        </DockPanel>
                    </StackPanel>
                    <ItemsControl x:Name="Legend">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsVisible}" Margin="0" Checked="OnLegendClick" Unchecked="OnLegendClick"
                                          AutomationProperties.Name="{Binding Name}">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="12" Height="12" Fill="{Binding Brush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}" Foreground="White"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Separator Margin="0,4"/>
                    <CheckBox x:Name="MarkWallsToggle" IsChecked="True" Checked="OnMarkWallsClick" Unchecked="OnMarkWallsClick"
                              ToolTip="Wandpfade rot bei Wand-Unterschreitung, grau bei erwarteter Abweichung">
                        <TextBlock Text="Wand-Abweichungen" Foreground="White"/>
                    </CheckBox>
                    <CheckBox x:Name="ThinShellsToggle" IsChecked="True" Checked="OnThinShellsClick" Unchecked="OnThinShellsClick"
                              ToolTip="Magenta Kreuze, wo weniger Schalenschichten gemessen als effektiv eingestellt sind">
                        <TextBlock Text="Dünne Schalenstellen" Foreground="White"/>
                    </CheckBox>
                    <CheckBox x:Name="GridToggle" IsChecked="True" Checked="OnGridClick" Unchecked="OnGridClick">
                        <TextBlock Text="Raster" Foreground="White"/>
                    </CheckBox>
                </StackPanel>
            </Border>

            <DockPanel x:Name="LayerPanel" Grid.Row="1" Margin="10,6" Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Left" Foreground="White" VerticalAlignment="Center" Width="110">
                    <Run Text="Layer "/><Run x:Name="LayerText"/>
                </TextBlock>
                <Button DockPanel.Dock="Right" Padding="10,2" Margin="4,0,0,0" Click="OnAllLayers">Alle</Button>
                <Button DockPanel.Dock="Right" Margin="4,0,0,0" Click="OnLayerPlus" Style="{StaticResource IconButton}"
                        Tag="{StaticResource Icon.plus}" Content="" ToolTip="Nächster Layer" AutomationProperties.Name="Nächster Layer"/>
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnLayerMinus" Style="{StaticResource IconButton}"
                        Tag="{StaticResource Icon.minus}" Content="" ToolTip="Vorheriger Layer" AutomationProperties.Name="Vorheriger Layer"/>
                <Slider x:Name="LayerSlider" Minimum="1" IsSnapToTickEnabled="True" TickFrequency="1"
                        SmallChange="1" LargeChange="10" VerticalAlignment="Center" ValueChanged="OnLayerChanged"/>
            </DockPanel>

            <Expander x:Name="ChartPanel" Grid.Row="2" Header="Zeit pro Layer (Wurzelskala)" Margin="10,0,10,6"
                      IsExpanded="True" Visibility="Collapsed">
                <local:LayerTimeChart x:Name="Chart" Height="110" Margin="0,4,0,0" LayerClicked="OnChartLayerClicked"/>
            </Expander>
        </Grid>

        <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="4,0,8,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Image x:Name="Preview" Stretch="Uniform" MaxHeight="180" Margin="0,0,0,8"/>
                <ItemsControl x:Name="Sections">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Header="{Binding Title}" IsExpanded="True" Margin="0,0,0,8" FontWeight="SemiBold">
                                <ItemsControl ItemsSource="{Binding Rows}" Margin="8,4,0,0" FontWeight="Normal">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" MaxWidth="190"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" Margin="8,0,0,0">
                                                    <TextBlock.Style>
                                                        <!-- Statusfarbe nur, wenn gesetzt; sonst Textfarbe des Themes -->
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{Binding Brush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Brush}" Value="{x:Null}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
